# ── .env.example ──────────────────────────────────────────────────────
# Copy this to .env and fill in your values

# ── HeLa Chain ────────────────────────────────────────────────────────
HELA_TESTNET_RPC=https://testnet-rpc.helachain.com
HELA_MAINNET_RPC=https://mainnet-rpc.helachain.com
PRIVATE_KEY=your_wallet_private_key_here_no_0x_prefix
HELA_EXPLORER_KEY=your_hela_explorer_api_key

# ── Contract addresses (filled after deploy) ──────────────────────────
AUDIT_ANCHOR_ADDRESS=
CHALLENGE_REGISTRY_ADDRESS=
POLICY_REGISTRY_ADDRESS=
AGENT_REGISTRY_ADDRESS=

# ── AI / LLM ──────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# ── IPFS (Pinata) ─────────────────────────────────────────────────────
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key
PINATA_JWT=your_pinata_jwt_token

# ── Alpaca (Paper Trading) ────────────────────────────────────────────
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Backend ───────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=your_jwt_secret_key_here

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/aap_db

# ── Agent Config ──────────────────────────────────────────────────────
AGENT_WALLET_ADDRESS=0x_your_agent_wallet_address
AUTO_APPROVE_LIMIT_INR=10000
RISK_THRESHOLD_AUTO=0.5
CHALLENGE_WINDOW_HOURS=24
BATCH_SIZE=10
MERKLE_BATCH_INTERVAL_SECONDS=300
